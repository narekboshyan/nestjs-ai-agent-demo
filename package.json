{
  "name": "nestjs-ai-agent-demo",
  "version": "0.1.0",
  "description": "Minimal NestJS 12 app with an AI agent built on @nestjs/ai: tools, guards and a chat endpoint.",
  "author": "Narek Boshyan",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "smoke": "tsc -p tsconfig.json && node dist/smoke.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@nestjs/ai": "^0.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/resilience": "^0.0.3",
    "ai": "^7.0.179",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
